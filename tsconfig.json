{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/qa-client/page/**/*.ts"],
  "exclude": [
    "**/*.test.ts",
    "packages/sec111-gateway/src/stage/**",
    "packages/sec111-gateway/src/testing/**",
    "packages/destruction-gateway/src/**",
    "packages/destruction-gateway/generated/**"
  ]
}
